{
  "name": "button-in-siyuan",
  "version": "0.4.0",
  "description": "Insert native SiYuan button blocks into documents",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build && node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-i18n.mjs && node scripts/check-docs.mjs && npm run typecheck && npm run typecheck:tests && npm run build"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "button"
  ],
  "author": "wmy2981",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "siyuan": "^1.2.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2"
  }
}
